# Optional Linux image for proving OTP :gen_sctp (association lifecycle).
# SCTP is optional on the host; many macOS builds return :eprotonosupport.
#
#   docker-compose -f docker-compose.sctp.yml run --rm xsockets-sctp
#
# Strips optional :ex_sctp (WebRTC / Rust) so this image only exercises
# Transport.SCTP / XSockets.Sctp.Listener over IP.
FROM hexpm/elixir:1.17.3-erlang-27.1.2-ubuntu-noble-20241015

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git libsctp1 libsctp-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV MIX_ENV=test

COPY mix.exs mix.lock ./
COPY config config

# Drop optional WebRTC SCTP dep for this proof image (needs Rust toolchain).
RUN sed -i '/ex_sctp/d' mix.exs \
  && mix local.hex --force && mix local.rebar --force \
  && mix deps.unlock ex_sctp \
  && mix deps.get \
  && mix deps.compile

COPY lib lib
COPY test test
COPY README.md ARCHITECTURE.md CHANGELOG.md LICENSE.md ./

CMD ["mix", "test", "--only", "sctp", "--trace"]

ENV XSCTP_REQUIRE=1
